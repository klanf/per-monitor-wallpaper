# 构建产物
dist/
out/

# 依赖
node_modules/

# 测试临时素材（每次跑验证脚本自动生成）
tools/tmp/

# 测试图库：120 张渐变 PNG，用 `npm run fixtures` 重新生成即可，不必进版本库
tools/fixtures/gallery/

# 纯色 BMP 测试素材，同样由 `npm run fixtures` 生成
# （tools/fixtures/two-screen/ 不在此列 —— 它不能自动生成，是 verify:e2e 的必需输入，要进版本库）
tools/fixtures/monitor-*.bmp

# 图标源图（AI 生成，约 1.2 MB）。
# `npm run icon` 需要它，但仓库里只放生成好的 assets/icon.ico 与 icon.png，
# 不放源图 —— 新克隆想重做图标就自备一张正方形 PNG 放在这里（≥256×256 即可）。
tools/icon-source.png

# 图标历史备份
tools/backup/

# 日志与本机杂项
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# 本机壁纸状态快照 / 调试输出（含真实路径与显示器设备 ID）
tools/wallpaper-backup.json
tools/verify-shots/

# 编辑器
.vscode/
.idea/

# 运行期生成的杂项（GPU 缓存之类）
NVIDIA Corporation/

# OCR 语言数据（首次跑 npm run ocr 会自动下载，约 30MB）
tools/.ocr-cache/

# 截图分析工具导出的中间图
tools/.crops/

# Python 工具（tools/build-exe.py 等）的字节码缓存
__pycache__/

# 深度视差素材模型（ISNet 176MB / LaMa 200MB+，下载脚本见 CHANGELOG 第八轮）
tools/models/*.onnx
tools/models/*.pt

# 深度模型（r26）：ONNX 99MB 不进版本库。JS 引擎按
# 「覆盖 → <appRoot>/models/depth-anything/depth_anything_v2_small.onnx → legacy」探测，
# 开发机放一份即可；打包时作为 extraResource/下载项提供（与 depth-env 同策略）。
models/

# 引导安装器构建产物（r39）：bootstrap.nsi 由模板渲染、build-log 是编译日志
tools/bootstrap-installer/build/

# 引导安装器构建产物（r39）：bootstrap.nsi 由模板渲染、build-log 是编译日志
tools/bootstrap-installer/build/
